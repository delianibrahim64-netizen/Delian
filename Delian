-- Dragging with touch or mouse
local dragging = false
local dragInput
local dragStart
local startPosition

local function clampPosition(x, y)
    local camera = Workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize

    if viewport then
        x = math.clamp(x, 0, math.max(0, viewport.X - panel.AbsoluteSize.X))
        y = math.clamp(y, 0, math.max(0, viewport.Y - panel.AbsoluteSize.Y))
    end

    return x, y
end

connect(header.InputBegan, function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    dragging = true
    dragStart = input.Position
    startPosition = panel.AbsolutePosition

    if input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

connect(UserInputService.InputChanged, function(input)
    if not dragging then return end

    local mouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
    local touchMove = input.UserInputType == Enum.UserInputType.Touch
        and input == dragInput

    if not mouseMove and not touchMove then return end

    local delta = input.Position - dragStart
    local x, y = clampPosition(
        startPosition.X + delta.X,
        startPosition.Y + delta.Y
    )

    panel.AnchorPoint = Vector2.zero
    panel.Position = UDim2.fromOffset(x, y)
end)

connect(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input == dragInput then
        dragging = false
        dragInput = nil
    end
end)

--========================================================
-- INSTANT EGG PICKUP LOOP: EVERY 0.1 SECONDS
--========================================================

local function makeEggPickupInstant(instance)
    if not instance:IsA("ProximityPrompt") then
        return
    end

    local current = instance.Parent
    local eggRelated = false

    while current and current ~= Workspace do
        if current.Name:lower():find("egg", 1, true) then
            eggRelated = true
            break
        end
        current = current.Parent
    end

    if not eggRelated then
        return
    end

    instance.HoldDuration = 0
    instance.RequiresLineOfSight = false
end

-- Recheck prompts continuously every 0.1 seconds
task.spawn(function()
    while alive do
        for _, instance in ipairs(Workspace:GetDescendants()) do
            if not alive then
                break
            end
            makeEggPickupInstant(instance)
        end

        task.wait(0.1)
    end
end)

-- Configure newly added prompts immediately
connect(Workspace.DescendantAdded, makeEggPickupInstant)

--========================================================
-- INTRO TIMELINE: 10 SECONDS
--========================================================

task.spawn(function()
    local startTime = os.clock()
    local duration = 10
    local decodeDuration = 6.5
    local target = "MADE BY DELIAN"
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

    tween(progressFill, duration, {
        Size = UDim2.fromScale(1, 1),
    }, Enum.EasingStyle.Linear)

    task.spawn(function()
        while alive and introActive and intro.Parent do
            titleGradient.Rotation = (titleGradient.Rotation + 1.5) % 360
            task.wait(0.035)
        end
    end)

    while alive and os.clock() - startTime < decodeDuration do
        local progress = math.clamp(
            (os.clock() - startTime) / decodeDuration,
            0,
            1
        )

        local revealed = math.floor(progress * #target)
        local output = {}

        for i = 1, #target do
            local char = target:sub(i, i)

            if char == " " or i <= revealed then
                output[i] = char
            else
                local index = math.random(1, #alphabet)
                output[i] = alphabet:sub(index, index)
            end
        end

        title.Text = table.concat(output)
        task.wait(0.045)
    end

    title.Text = target
    subtitle.Text = "WELCOME, DELIAN"
    status.Text = "ACCESS GRANTED  //  READY"

    tween(title, 0.35, {TextStrokeTransparency = 0})

    while alive and os.clock() - startTime < 9.4 do
        task.wait(0.05)
    end

    if not alive then
        return
    end

    local remaining = math.max(0, duration - (os.clock() - startTime))

    local fadeObjects = {
        intro, title, subtitle, status, progressBack, atmosphere,
    }

    for _, object in ipairs(fadeObjects) do
        if object.Parent then
            local properties = {}

            if object:IsA("Frame") then
                properties.BackgroundTransparency = 1
            end

            if object:IsA("TextLabel") then
                properties.TextTransparency = 1
                if object == title then
                    properties.TextStrokeTransparency = 1
                end
            end

            tween(object, remaining, properties)
        end
    end

    for _, object in ipairs(intro:GetChildren()) do
        if object:IsA("Frame") then
            local stroke = object:FindFirstChildOfClass("UIStroke")
            if stroke then
                tween(stroke, remaining, {Transparency = 1})
            end
        end
    end

    task.wait(remaining)

    introActive = false
    intro:Destroy()

    panel.Visible = true
    panel.AnchorPoint = Vector2.new(1, 0)
    panel.Position = UDim2.new(1, 260, 0, 65)

    tween(panel, 0.45, {
        Position = UDim2.new(1, -16, 0, 65),
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
end)

